{
  "name": "tcc-controle-parental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p src/pwa/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "build": "next build && node scripts/pwa/generate-sw.ts",
    "verify": "node scripts/verify/verify.ts",
    "e2e": "playwright test",
    "sonar:up": "node scripts/sonar/up.ts",
    "sonar:setup": "node scripts/sonar/setup.ts",
    "sonar": "node scripts/sonar/analyze.ts",
    "metrics:ia": "node scripts/metrics/record-ia.ts",
    "metrics:check": "node scripts/metrics/check-ia.ts",
    "metrics:consolidar": "node scripts/metrics/consolidate.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sonar/scan": "5.0.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
